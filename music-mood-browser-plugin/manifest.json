{
  "manifest_version": 3,
  "name": "Mood Music Logger",
  "version": "1.0",
  "description": "Logs active Spotify or YouTube tracks with Circumplex mood labels.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://open.spotify.com/*",
    "https://www.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}